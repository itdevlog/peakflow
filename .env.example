BOT_TOKEN=
CHILD_ID=0
PARENT_IDS=0,0
CHILD_NAME=Ребёнок
TARGET_PEF=260
DB_PATH=peakflow.db
TZ_OFFSET=5

# Веб-версия (Telegram Mini App), работает в процессе бота
# 127.0.0.1 безопаснее: порт не торчит в интернет, доступ только через Caddy.
# Для нескольких ботов на одном сервере — свой WEBAPP_PORT каждому (8080, 8081, ...).
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Публичный HTTPS-URL Mini App. Пусто = кнопка Mini App не добавляется.
# Пример: https://pick.example.com
WEBAPP_URL=

# Метрики (SP4D). 1 = включить GET /metrics (Prometheus text); 0 = эндпоинт отдаёт 404.
METRICS_ENABLED=0
# Bearer-токен для /metrics. Рекомендуется всегда, когда WEBAPP_URL публичен / за Caddy:
# сгенерированный vhost проксирует ВСЕ пути, включая /metrics. Пусто = без токена.
METRICS_TOKEN=